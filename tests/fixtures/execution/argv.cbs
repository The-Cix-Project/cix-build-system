package "argv-test" {
    version "1"
    release 1
    format "cixpkg"
    build {
        run "${build}/exec-test" {
            "--probe-with-env"
            "space value"
            "\"double quotes\""
            "$"
            "*"
            ";"
            "'single quotes'"
            "back\\slash"
            ""
            "jobs=${jobs}"
            env "CBS_TEST_ENV" = "literal $ * ; \" '"
            env "ac_cv_prog_CC" = "tcc"
            jobs $jobs
            expect exit 23
        }
        run "${build}/exec-test" {
            "--probe-without-env"
        }
        run "${build}/exec-test" {
            "--probe-fail"
        }
        run "${build}/exec-test" {
            "--probe-sleep"
            timeout 10ms
        }
        run "${build}/exec-test" {
            "--probe-signal"
        }
        run "${build}/exec-test" {
            "--probe-limit"
        }
        run "make" {
            "-s"
            "-f"
            "${src}/tests/fixtures/execution/cc-precedence.mk"
            "print"
            "CC=recipe-cc"
            expect { stdout contains "origin=command line cc=recipe-cc" }
        }
        run "${build}/exec-test" {
            "--probe-stderr"
            expect { stderr contains "2.19.1" }
            stderr "VERSION"
        }
        run "printf" {
            "${stderr.VERSION}\n"
            expect { stdout contains "stderr version 2.19.1" }
        }
        run "${build}/exec-test" {
            "--probe-stderr"
            stderr file "${dest}/stderr-output"
        }
        run "${build}/exec-test" {
            "--probe-glob-args"
            args glob "${src}/tests/fixtures/execution/*.cbs"
        }
    }
}
