package "extract-test" {
    version "1"
    release 1
    sources {
        main "main" {
            url "https://example.invalid/main.tar"
            sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
        extra "support" {
            url "https://example.invalid/support.tar"
            sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
        extra "config" {
            url "https://example.invalid/config"
            sha256 "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
    }
    prepare {
        extract $source.support into $src as "support"
        materialize $source.config to "${build}/.config"
        require config "${build}/.config" {
            CONFIG_TEST = y
            CONFIG_DISABLED = n
            CONFIG_OPTIONAL = absent
        }
    }
}
