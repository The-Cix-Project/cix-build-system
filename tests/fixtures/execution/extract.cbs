package "extract-test" {
    version "1"
    release 1
    format "cixpkg"
    sources {
        main "main" {
            url "https://example.invalid/main.tar"
            sha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
        extra "support" {
            url "https://example.invalid/support.tar"
            sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
        extra "config" {
            url "https://example.invalid/config"
            sha256 "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        }
        extra "selective" {
            url "https://example.invalid/selective.tar"
            sha256 "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
        }
        extra "artifact" {
            url "https://example.invalid/artifact.cixpkg"
            sha256 "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
        }
    }
    prepare {
        mkdir "${build}/kernel"
        mkdir "${build}/artifact"
        extract $source.support into $src as "support"
        extract $source.selective into "${build}/kernel" {
            member "bzImage"
        }
        extract $source.artifact into "${build}/artifact"
        materialize $source.config to "${build}/.config"
        require config "${build}/.config" {
            CONFIG_TEST = y
            CONFIG_DISABLED = n
            CONFIG_OPTIONAL = absent
        }
    }
}
