package "edit-assert-test" {
    version "1"
    release 1
    format "cixpkg"

    build {
        mkdir "${build}/matches"
        write "${src}/patch-target.txt" "old\nkeep\n"
        patch "patch-test.diff" {
            sha256 "5532d3fb640c172c20104b35415774b5fd3f8910eef21154fedbeccbcdbe3574"
            strip 1
        }
        require file "${src}/patch-target.txt" {
            exists
            contains "new\nkeep"
        }
        write "${build}/input.bin" "old middle old" chmod 0640
        write "${build}/truncate.txt" "keep\nCUT\ndiscarded\n"
        truncate "${build}/truncate.txt" {
            from "CUT"
            exactly 1
        }
        write "${build}/matches/a" "a"
        write "${build}/matches/b" "b"
        glob "selected" = "${build}/matches/a"
        require file "${glob.selected}" {
            exists
        }
        replace "${build}/input.bin" {
            from "old"
            to "new"
            exactly 2
        }
        insert "${build}/input.bin" {
            after "new"
            write "!"
            exactly 2
        }
        require file "${build}/input.bin" {
            exists
            contains "new! middle"
            contains "middle new!"
        }
        write "${build}/before.bin" "old middle old"
        insert "${build}/before.bin" {
            before "old"
            write "!"
            exactly 2
        }
        require file "${build}/before.bin" {
            exists
            contains "!old middle !old"
        }
        require directory "${build}/matches" {
            exists
        }
        require glob "${build}/matches/*" {
            count 2
        }
        require glob "${build}/matches/*.missing" {
            exactly 0
        }
        write "${build}/link.mk" "LDFLAGS = -Wl,--version-script=libfoo.map -shared\nLDFLAGS2 = -Wl,--version-script=lib/bar.map\n"
        replace "${build}/link.mk" {
            from "-Wl,--version-script="
            until whitespace
            to ""
            exactly 2
        }
        require file "${build}/link.mk" {
            exists
            contains "LDFLAGS =  -shared\nLDFLAGS2 = \n"
        }
        write "${build}/line.mk" "CFLAGS += -O2 -g\nKEEP = 1\n"
        replace "${build}/line.mk" {
            from "CFLAGS +="
            until line
            to "CFLAGS += -O0"
            exactly 1
        }
        require file "${build}/line.mk" {
            exists
            contains "CFLAGS += -O0\nKEEP = 1\n"
        }
        mkdir "${build}/shebang"
        write "${build}/shebang/a.sh" "#!/bin/bash\ncat <<'EOF'\n#!/bin/bash\nEOF\n"
        write "${build}/shebang/b.sh" "#!/bin/bash\necho ok\n"
        replace glob "${build}/shebang/*.sh" {
            from "#!/bin/bash"
            at line 1
            to "#!/usr/bin/bash"
            exactly 2
        }
        replace "${build}/shebang/a.sh" {
            from "#!/bin/bash"
            at line_start
            to "#!/usr/bin/bash"
            exactly 1
        }
        require file "${build}/shebang/a.sh" {
            exists
            contains "#!/usr/bin/bash\ncat <<'EOF'\n#!/usr/bin/bash\n"
        }
        require file "${build}/shebang/b.sh" {
            exists
            contains "#!/usr/bin/bash\necho ok\n"
        }
        symlink "input.bin" to "${build}/input-link"
        symlink "missing" to "${build}/dangling"
        require symlink "${build}/input-link" {
            exists
            target "input.bin"
        }
        require symlink "${build}/dangling" {
            exists
        }
    }
}
