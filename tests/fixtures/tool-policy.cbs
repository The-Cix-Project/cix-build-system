package "tool-policy" {
    version "1"
    release 1
    format "cixpkg"

    requires {
        build {
            compiler "tcc"
        }
    }

    tools {
        compiler alias "cc"
    }

    build {
        require tool "cc"
        run "cc" { "alias-argument" }
        write "${dest}/tool-policy.txt" "ok"
    }
}
