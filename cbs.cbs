package "cbs" {
    version "0.1.29"
    release 1
    format "cixpkg"
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.29.tar.gz"
            sha256 "0d20f4d2980eeb4b4e551199580130bcf3251a2a773548e65741d834a2b8fd89"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
