package "cbs" {
    version "0.1.30"
    release 1
    format "cixpkg"
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.30.tar.gz"
            sha256 "c4ccc90ec62549953d89c2fae2c4dea78e2071ab4d8700260629d071b0a43109"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
