package "cbs" {
    version "0.1"
    release 1
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.21.tar.gz"
            sha256 "852bbedfe83dc5f3a154e54216874138e6ccc88889e8ce3d80477a6750b6ea6c"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
