package "cbs" {
    version "0.1.122"
    release 1
    format "cixpkg"
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.122.tar.gz"
            sha256 "438c520a78d928bae61eaaef58670b42b9f020b74cd519ec571494ea8e72c686"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
