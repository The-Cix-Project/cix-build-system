package "cbs" {
    version "0.1.23"
    release 1
    format "cixpkg"
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.23.tar.gz"
            sha256 "66d5d353ffce97e07c0c8150f32f2d4e795c502b3dc24d04f092b43e2a18f18c"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
