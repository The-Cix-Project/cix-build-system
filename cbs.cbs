package "cbs" {
    version "0.1.133"
    release 1
    format "cixpkg"
    sources {
        main "cbs" {
            url "https://git.home.arpa/itdlabs/cix-build-system/archive/v0.1.133.tar.gz"
            sha256 "aff2a0588a15c0008349dae7e9a228da19da1cf0e0b8a5a53db48d43bf9bac4e"
        }
    }
    requires {
        build { compiler "tcc" tool "make" }
        runtime { library "libarchive" library "libzstd" }
        bootstrap { compiler "tcc" }
    }
    configure { run "true" { expect exit 0 } }
    build { run "make" { jobs $jobs } }
    check { run "make" { "test" } }
}
