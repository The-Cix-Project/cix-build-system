# CBS migration of the Cix builder recipe.
#
# This recipe keeps Cix's own source, build, selftest, mutation gate, and
# staged install inside CPDL. The legacy build-image and CAP_SYS_ADMIN fields
# are intentionally not copied: CPDL 0.1 has no syntax for those executor
# policy controls yet, so they remain deployment metadata until that contract
# is defined.
package "cix" {
    version "v2.57.55"
    release 1
    format "cixpkg"

    sources {
        main "cix" {
            url "https://osakka:{{REPO_TOKEN}}@git.home.arpa/api/v1/repos/itdlabs/cix/archive/v2.57.55.tar.gz"
            sha256 "56ff5fe2c6acfdbba5f53ddb3acadc8f10a6c4d09facb5728f6190bb770e0c85"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "linux-headers"
            tool "openssl"
            tool "binutils"
        }
        bootstrap {
            compiler "tcc"
        }
    }

    build_image "cix-builder"
    capability "CAP_SYS_ADMIN"

    prepare {
        require directory "${src}/cix-v2.57.55" {
            exists
        }
    }

    build {
        cd "${src}/cix-v2.57.55" {
            run "make" {
                "CIX_VERSION=${version}"
                "build/cix-init"
                "build/cixd"
                "build/cixctl"
                "build/mkbootroot"
                "build/cix-install"
                "build/cix-recover"
                "build/mkinstalleriso"
                "build/cix-boot.efi"
                "build/cix-xorriso"
                env "CC" = "tcc"
                jobs $jobs
            }
            run "make" {
                "CIX_VERSION=${version}"
                "selftest"
                env "CC" = "tcc"
                jobs $jobs
            }

            # #296 mutation gate: the console-input test must fail when the
            # session is deliberately poisoned, proving that the selftest is
            # detecting the historical uninitialised-state bug rather than
            # merely passing on zero-filled pages.
            replace "daemon/src/main.c" {
                from "\tmemset(sess, 0, sizeof(*sess));"
                to "\tmemset(sess, 0xff, sizeof(*sess)); /* #296 proof */"
                exactly 1
            }
            run "make" {
                "CIX_VERSION=${version}"
                "build/cixd"
                env "CC" = "tcc"
                jobs $jobs
            }
            run "./build/test_console_exec" {
                expect exit 1
                timeout 2m
            }
            replace "daemon/src/main.c" {
                from "\tmemset(sess, 0xff, sizeof(*sess)); /* #296 proof */"
                to "\tmemset(sess, 0, sizeof(*sess));"
                exactly 1
            }
            run "make" {
                "CIX_VERSION=${version}"
                "build/cixd"
                env "CC" = "tcc"
                jobs $jobs
            }
        }
    }

    check {
        require file "${src}/cix-v2.57.55/build/cixd" {
            exists
        }
        require file "${src}/cix-v2.57.55/build/cix-boot.efi" {
            exists
            contains "MZ"
        }
        require file "${src}/cix-v2.57.55/web/index.html" {
            exists
        }
        require file "${src}/cix-v2.57.55/web/app.js" {
            exists
        }
        require file "${src}/cix-v2.57.55/web/style.css" {
            exists
        }
        require file "${src}/cix-v2.57.55/web/api.js" {
            exists
        }
    }

    install {
        mkdir "${dest}/web"
        copy "${src}/cix-v2.57.55/build/cix-init" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cixd" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cixctl" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/mkbootroot" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cix-install" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cix-recover" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/mkinstalleriso" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cix-boot.efi" to "${dest}/"
        copy "${src}/cix-v2.57.55/build/cix-xorriso" to "${dest}/"
        copy "${src}/cix-v2.57.55/web/index.html" to "${dest}/web/"
        copy "${src}/cix-v2.57.55/web/app.js" to "${dest}/web/"
        copy "${src}/cix-v2.57.55/web/style.css" to "${dest}/web/"
        copy "${src}/cix-v2.57.55/web/api.js" to "${dest}/web/"
        require file "${dest}/cix-boot.efi" {
            exists
            contains "MZ"
        }
    }
}
