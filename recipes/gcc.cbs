# GCC migration draft from the repository's documented GCC stress case.
#
# GCC's own prerequisite sources are declared separately so CBS verifies them
# before phase execution and the build never invokes download_prerequisites.
#
package "gcc" {
    version "16.2.0"
    release 16

    sources {
        main "gcc" {
            url "https://mirrors.kernel.org/gnu/gcc/gcc-16.2.0/gcc-16.2.0.tar.xz"
            sha256 "e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e"
        }
        extra "gmp" {
            url "https://gcc.gnu.org/pub/gcc/infrastructure/gmp-6.3.0.tar.bz2"
            sha256 "ac28211a7cfb609bae2e2c8d6058d66c8fe96434f740cf6fe2e47b000d1c20cb"
        }
        extra "mpfr" {
            url "https://gcc.gnu.org/pub/gcc/infrastructure/mpfr-4.2.2.tar.bz2"
            sha256 "9ad62c7dc910303cd384ff8f1f4767a655124980bb6d8650fe62c815a231bb7b"
        }
        extra "mpc" {
            url "https://gcc.gnu.org/pub/gcc/infrastructure/mpc-1.3.1.tar.gz"
            sha256 "ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "binutils"
            tool "make"
            tool "m4"
            tool "gawk"
            tool "findutils"
            tool "patch"
            tool "tar"
            tool "bzip2"
            tool "gzip"
            tool "diffutils"
            library "zlib"
            headers "libc-dev"
        }
        test {
            tool "dejagnu"
        }
        bootstrap {
            compiler "tcc"
        }
    }

    prepare {
        require directory "${src}/gcc/gcc-16.2.0" {
            exists
        }
        require file "${src}/gcc/gcc-16.2.0/configure" {
            exists
        }
        extract $source.gmp into "${src}/gcc" as "gmp"
        extract $source.mpfr into "${src}/gcc" as "mpfr"
        extract $source.mpc into "${src}/gcc" as "mpc"
        require directory "${src}/gcc/gmp" { exists }
        require directory "${src}/gcc/mpfr" { exists }
        require directory "${src}/gcc/mpc" { exists }
    }

    configure {
        cd $build {
            run "${src}/gcc/gcc-16.2.0/configure" {
                "--prefix=/usr"
                "--enable-languages=c"
                "--disable-multilib"
                "--disable-lto"
                "--disable-libsanitizer"
                "--disable-nls"
                "--with-system-zlib"
                env "CC" = "tcc"
                env "CXX" = "tcc"
            }
        }
    }

    build {
        cd $build {
            run "make" {
                "-j${jobs}"
                jobs $jobs
            }
        }
    }

    check {
        require directory "${src}/gcc/gcc-16.2.0" {
            exists
        }
        # The legacy DejaGNU and bootstrap reproducibility gates remain to be
        # translated into explicit CBS assertions.
    }

    install {
        cd $build {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        require file "${dest}/usr/bin/gcc" {
            exists
        }
    }
}
