# Source-built libarchive used by CBS for safe archive inspection/extraction.
package "libarchive" {
    version "3.6.2"
    release 1
    format "cixpkg"
    sources {
        main "libarchive" {
            url "https://github.com/libarchive/libarchive/releases/download/v3.6.2/libarchive-3.6.2.tar.xz"
            sha256 "9e2c1b80d5fbe59b61308fdfab6c79b5021d7ff4ff2489fb12daf0a96a83551d"
        }
    }
    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "xz"
            tool "bzip2"
            tool "zlib"
        }
        runtime {
            library "xz"
            library "bzip2"
            library "zlib"
        }
    }
    prepare { require directory "${src}/libarchive-3.6.2" { exists } }
    build {
        cd "${src}/libarchive-3.6.2" {
            run "./configure" {
                "--prefix=/usr"
                "--disable-static"
                "--without-libb2"
                "--without-lz4"
                "--without-openssl"
                "--without-xml2"
                "--without-nettle"
                "--without-zstd"
            }
            run "make" { jobs $jobs }
        }
    }
    check {
        require file "${src}/libarchive-3.6.2/.libs/libarchive.so" { exists }
    }
    install {
        cd "${src}/libarchive-3.6.2" {
            run "make" { "install" "DESTDIR=${dest}" jobs $jobs }
        }
    }
}
