# CBS migration of squashfs-tools. The build is intentionally limited to the
# formats this project produces and consumes: XZ only, with the upstream
# single-reader mode used when TCC cannot provide atomic exchange builtins.
package "squashfs-tools" {
    version "4.7.5"
    release 12

    sources {
        main "squashfs-tools" {
            url "https://github.com/plougher/squashfs-tools/archive/refs/tags/4.7.5.tar.gz"
            sha256 "547b7b7f4d2e44bf91b6fc554664850c69563701deab9fd9cd7e21f694c88ea6"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "bash"
            tool "coreutils"
            tool "linux-headers"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "findutils"
            tool "diffutils"
            tool "xz"
            tool "zlib"
        }
        runtime {
            library "gcc-runtime"
            library "xz-runtime"
            library "libc"
        }
    }

    prepare {
        require directory "${src}/squashfs-tools-4.7.5" { exists }
    }

    build {
        cd "${src}/squashfs-tools-4.7.5" {
            run "make" {
                "GZIP_SUPPORT=0"
                "XZ_SUPPORT=1"
                "LZO_SUPPORT=0"
                "LZ4_SUPPORT=0"
                "ZSTD_SUPPORT=0"
                "XATTR_SUPPORT=0"
                "COMP_DEFAULT=xz"
                "EXTRA_CFLAGS=-D__STDC_NO_VLA__=1 -Dlinux=1"
                "DONT_USE_ATOMIC_EXCHANGE_N=1"
                "SINGLE_READER_THREAD=1"
                jobs $jobs
            }
        }
    }

    check {
        mkdir "${build}/sqcheck/src/sub" chmod 0755
        write "${build}/sqcheck/src/hello.txt" "cix squashfs build gate\n"
        write "${build}/sqcheck/src/sub/two.txt" "second\n"
        cd "${src}/squashfs-tools-4.7.5" {
            run "./mksquashfs" {
                "${build}/sqcheck/src"
                "${build}/sqcheck/out.squashfs"
                "-noappend"
                timeout 2m
            }
            run "./unsquashfs" {
                "-s"
                "${build}/sqcheck/out.squashfs"
                timeout 2m
            }
        }
        require file "${build}/sqcheck/out.squashfs" {
            exists
            contains "hsqs"
        }
    }

    install {
        mkdir "${dest}/usr/bin" chmod 0755
        copy "${src}/squashfs-tools-4.7.5/mksquashfs" to "${dest}/usr/bin/mksquashfs"
        copy "${src}/squashfs-tools-4.7.5/unsquashfs" to "${dest}/usr/bin/unsquashfs"
        symlink "/usr/bin/mksquashfs" to "${dest}/usr/bin/sqfstar"
        symlink "/usr/bin/unsquashfs" to "${dest}/usr/bin/sqfscat"
        require file "${dest}/usr/bin/mksquashfs" { exists }
        require file "${dest}/usr/bin/unsquashfs" { exists }
    }
}
