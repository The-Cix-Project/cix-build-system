# TCC migration from the legacy shell recipe tcc/0.9.28rc-29.
#
# The source and package identity are carried over exactly. The legacy recipe's
# pkg_build() is intentionally not copied: its sed/cat/for/if shell logic must
# become explicit CPDL operations or a reviewed CBS capability.
#
# Migration status:
# - source identity and build dependencies: carried over;
# - configure, build, install, and documentation pruning: represented below
#   and successfully built in the local CBS sandbox;
# - compatibility edits and executable gates: represented below for the
#   pinned source;
# - the libc triplet is computed from the target architecture by CBS;
# - the three-stage bootstrap is represented with isolated compiler/runtime
#   snapshots and a byte-identity comparison;
# - this recipe is therefore a validated migration draft, not yet a release
#   replacement for the shell recipe.
#
package "tcc" {
    version "0.9.28rc"
    release 29
    format "cixpkg"

    sources {
        main "tcc" {
            url "https://codeload.github.com/TinyCC/tinycc/tar.gz/2ba12e83b3599ca8f5d50c179fe5138fe956f0c9"
            sha256 "4eb5f0266d4d9deabe9650abedc3f0261dc06295f89ad798bb495abf680dc074"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
            tool "diffutils"
        }
        bootstrap {
            compiler "tcc"
        }
    }

    prepare {
        require directory "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9" {
            exists
        }
        # The original recipe's C11 predefines are source edits, not build
        # environment settings. Exact cardinality makes a moved upstream line
        # fail closed instead of silently dropping the compatibility fix.
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include/tccdefs.h" {
            from "    # define __STDC_NO_ATOMICS__ 1"
            to ""
            exactly 1
        }
        insert "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include/tccdefs.h" {
            after "    #undef __BUILTIN_EXTERN"
            write "\n    unsigned short __builtin_bswap16(unsigned short);\n    unsigned int __builtin_bswap32(unsigned int);\n    unsigned long long __builtin_bswap64(unsigned long long);"
            exactly 1
        }
        insert "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include/tccdefs.h" {
            after "#endif /* ndef __TCC_PP__ */"
            write "\n    #define __ATOMIC_RELAXED 0\n    #define __ATOMIC_CONSUME 1\n    #define __ATOMIC_ACQUIRE 2\n    #define __ATOMIC_RELEASE 3\n    #define __ATOMIC_ACQ_REL 4\n    #define __ATOMIC_SEQ_CST 5"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/lib/Makefile" {
            from "COMMON_O = stdatomic.o atomic.o builtin.o alloca.o alloca-bt.o"
            to "COMMON_O = stdatomic.o atomic.o atomic_compat.o builtin.o builtin_compat.o alloca.o alloca-bt.o"
            exactly 1
        }
        write "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/lib/atomic_compat.c" """
            int __atomic_test_and_set(volatile void *ptr, int memorder)
            {
                unsigned char previous = 1;
                (void)memorder;
                __asm__ __volatile__("xchgb %0, %1"
                                     : "+q"(previous), "+m"(*(volatile unsigned char *)ptr)
                                     :
                                     : "memory");
                return previous != 0;
            }

            void __atomic_clear(volatile void *ptr, int memorder)
            {
                unsigned char zero = 0;
                (void)memorder;
                __asm__ __volatile__("xchgb %0, %1"
                                     : "+q"(zero), "+m"(*(volatile unsigned char *)ptr)
                                     :
                                     : "memory");
            }
            """
        write "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/lib/builtin_compat.c" """
            unsigned short __builtin_bswap16(unsigned short value)
            {
                return (unsigned short)(((value & 0xff00u) >> 8) |
                                        ((value & 0x00ffu) << 8));
            }

            unsigned int __builtin_bswap32(unsigned int value)
            {
                return ((value & 0xff000000u) >> 24) |
                       ((value & 0x00ff0000u) >> 8) |
                       ((value & 0x0000ff00u) << 8) |
                       ((value & 0x000000ffu) << 24);
            }

            unsigned long long __builtin_bswap64(unsigned long long value)
            {
                return ((value & 0xff00000000000000ULL) >> 56) |
                       ((value & 0x00ff000000000000ULL) >> 40) |
                       ((value & 0x0000ff0000000000ULL) >> 24) |
                       ((value & 0x000000ff00000000ULL) >> 8) |
                       ((value & 0x00000000ff000000ULL) << 8) |
                       ((value & 0x0000000000ff0000ULL) << 24) |
                       ((value & 0x000000000000ff00ULL) << 40) |
                       ((value & 0x00000000000000ffULL) << 56);
            }
            """
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/libtcc.c" {
            from "    s->cversion = 199901; /* default unless -std=c11 is supplied */"
            to "    s->cversion = 201112; /* default C11 mode for the Cix toolchain */"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccelf.c" {
            from "    int dyna;"
            to "    int dyna;\n    int stack;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccelf.c" {
            from "    d->phnum = phnum;"
            to "    d->stack = phnum++;\n    d->phnum = phnum;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccelf.c" {
            from "        fill_phdr(&d->phdr[d->ehfr], PT_GNU_EH_FRAME, eh_frame_hdr_section);"
            to "        fill_phdr(&d->phdr[d->ehfr], PT_GNU_EH_FRAME, eh_frame_hdr_section);\n    ph2 = fill_phdr(&d->phdr[d->stack], PT_GNU_STACK, NULL);\n    ph2->p_flags = PF_R | PF_W;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccdbg.c" {
            from "    dwarf_reloc(eh_frame_section, eh_section_sym, R_X86_64_PC32);"
            to "    put_elf_reloca(symtab_section, eh_frame_section, eh_frame_section->data_offset, R_X86_64_PC32, eh_section_sym, func_ind);"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "    int c;\n    const char *msg;"
            to "    int64_t c;\n    const char *msg;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "    c = expr_const();\n    msg = \"_Static_assert fail\";"
            to "    c = expr_const64();\n    msg = \"_Static_assert fail\";"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tcc.h" {
            from "    func_alwinl : 1, /* always_inline */"
            to "    func_alwinl : 1, /* always_inline */\n    func_ctorprio : 15; /* constructor/destructor priority */"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tcc.h" {
            from "    xxxx        : 15;"
            to ""
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "        case TOK_CONSTRUCTOR1:\n        case TOK_CONSTRUCTOR2:\n            ad->f.func_ctor = 1;\n            break;"
            to "        case TOK_CONSTRUCTOR1:\n        case TOK_CONSTRUCTOR2:\n            ad->f.func_ctor = 1;\n            if (tok == '(') { next(); n = expr_const(); if (n < 0 || n > 32767) tcc_error(\"constructor priority out of range\"); ad->f.func_ctorprio = n; skip(')'); }\n            break;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "        case TOK_DESTRUCTOR1:\n        case TOK_DESTRUCTOR2:\n            ad->f.func_dtor = 1;\n            break;"
            to "        case TOK_DESTRUCTOR1:\n        case TOK_DESTRUCTOR2:\n            ad->f.func_dtor = 1;\n            if (tok == '(') { next(); n = expr_const(); if (n < 0 || n > 32767) tcc_error(\"destructor priority out of range\"); ad->f.func_ctorprio = n; skip(')'); }\n            break;"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "        add_array (tcc_state, \".init_array\", sym->c);"
            to "        { char psec[32]; if (sym->type.ref->f.func_ctorprio) snprintf(psec, sizeof(psec), \".init_array.%05u\", sym->type.ref->f.func_ctorprio); else snprintf(psec, sizeof(psec), \".init_array\"); add_array (tcc_state, psec, sym->c); }"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "        add_array (tcc_state, \".fini_array\", sym->c);"
            to "        { char psec[32]; if (sym->type.ref->f.func_ctorprio) snprintf(psec, sizeof(psec), \".fini_array.%05u\", sym->type.ref->f.func_ctorprio); else snprintf(psec, sizeof(psec), \".fini_array\"); add_array (tcc_state, psec, sym->c); }"
            exactly 1
        }
        replace "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccgen.c" {
            from "      fa->func_dtor = 1;\n}"
            to "      fa->func_dtor = 1;\n    if (fa1->func_ctorprio)\n      fa->func_ctorprio = fa1->func_ctorprio;\n}"
            exactly 1
        }
        write "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/cix_initarray.inc" """
            static void cix_merge_prio_arrays(TCCState *s1, const char *base_name)
            {
                Section *base = NULL;
                int idx[64], n = 0, i, j;
                size_t prefix_len = strlen(base_name);
                ElfW_Rel *saved = NULL;
                int saved_n = 0;
                for (i = 1; i < s1->nb_sections; i++) {
                    Section *s = s1->sections[i];
                    if (strncmp(s->name, base_name, prefix_len) != 0) continue;
                    if (s->name[prefix_len] == '\0') { base = s; continue; }
                    if (s->name[prefix_len] == '.' && n < 64) idx[n++] = i;
                }
                if (!n) return;
                for (i = 1; i < n; i++) { int cur = idx[i]; for (j = i - 1; j >= 0 && strcmp(s1->sections[idx[j]]->name, s1->sections[cur]->name) > 0; j--) idx[j + 1] = idx[j]; idx[j + 1] = cur; }
                if (!base) { base = find_section(s1, base_name); base->sh_flags = SHF_ALLOC; base->sh_type = base_name[1] == 'i' ? SHT_INIT_ARRAY : SHT_FINI_ARRAY; }
                if (base->reloc && base->reloc->data_offset) { saved_n = base->reloc->data_offset / sizeof(ElfW(Rel)); saved = tcc_malloc(base->reloc->data_offset); memcpy(saved, base->reloc->data, base->reloc->data_offset); }
                base->data_offset = 0; if (base->reloc) base->reloc->data_offset = 0;
                for (i = 0; i < n; i++) {
                    Section *s = s1->sections[idx[i]], *sr = s->reloc;
                    int k, count;
                    if (!sr) continue;
                    count = sr->data_offset / sizeof(ElfW_Rel);
                    for (k = 0; k < count; k++) {
                        ElfW_Rel *rel = &((ElfW_Rel *)sr->data)[k];
                        addr_t addend = rel->r_addend;
                        put_elf_reloca(symtab_section, base, base->data_offset,
                                       ELFW(R_TYPE)(rel->r_info), ELFW(R_SYM)(rel->r_info), addend);
                        section_ptr_add(base, PTR_SIZE);
                    }
                    s->data_offset = 0;
                    s->sh_flags &= ~SHF_ALLOC;
                    sr->data_offset = 0;
                }
                for (i = 0; i < saved_n; i++) {
                    ElfW_Rel *rel = &saved[i];
                    addr_t addend = rel->r_addend;
                    put_elf_reloca(symtab_section, base, base->data_offset,
                                   ELFW(R_TYPE)(rel->r_info), ELFW(R_SYM)(rel->r_info), addend);
                    section_ptr_add(base, PTR_SIZE);
                }
                tcc_free(saved);
            }
            """
        insert "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccelf.c" {
            after "#include \"tcc.h\""
            write "\n#include \"cix_initarray.inc\""
            exactly 1
        }
        insert "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/tccelf.c" {
            after "    add_init_array_defines(s1, \".preinit_array\");"
            write "\n    cix_merge_prio_arrays(s1, \".init_array\");\n    cix_merge_prio_arrays(s1, \".fini_array\");"
            exactly 1
        }
    }

    configure {
        cd $build {
            # This recipe carries the measured x86-64 TCC source fixes,
            # including R_X86_64 .eh_frame handling and ELF64 gates. Reject
            # another package architecture before configure rather than
            # applying those patches to an unverified target.
            run "test" {
                "${arch}"
                "="
                "x86_64"
            }
            run "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/configure" {
                "--prefix=/usr"
                "--cc=tcc"
                "--libpaths={B}:/usr/lib:/usr/lib/${triplet}:/lib:/lib/${triplet}"
                env "CC" = "tcc"
            }
        }
    }

    build {
        cd $build {
            run "make" {
                "-j${jobs}"
                jobs $jobs
            }
            # Stage 1 is the compiler just built from the installed seed.
            # Keep its runtime archive beside it before make clean removes
            # the ordinary build products.
            mkdir "${build}/cix-stage1"
            copy "${build}/tcc" to "${build}/cix-stage1/tcc"
            copy "${build}/libtcc1.a" to "${build}/cix-stage1/libtcc1.a"
            run "cp" {
                "-r"
                "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
                "${build}/cix-stage1/"
            }
            run "make" {
                "clean"
                jobs $jobs
            }
            run "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/configure" {
                "--prefix=/usr"
                "--cc=${build}/cix-stage1/tcc -B${build}/cix-stage1"
                "--libpaths={B}:/usr/lib:/usr/lib/${triplet}:/lib:/lib/${triplet}"
                env "CC" = "${build}/cix-stage1/tcc -B${build}/cix-stage1"
            }
            run "make" {
                "-j${jobs}"
                jobs $jobs
            }
            mkdir "${build}/cix-stage2"
            copy "${build}/tcc" to "${build}/cix-stage2/tcc"
            copy "${build}/libtcc1.a" to "${build}/cix-stage2/libtcc1.a"
            run "cp" {
                "-r"
                "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
                "${build}/cix-stage2/"
            }
            run "make" {
                "clean"
                jobs $jobs
            }
            run "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/configure" {
                "--prefix=/usr"
                "--cc=${build}/cix-stage2/tcc -B${build}/cix-stage2"
                "--libpaths={B}:/usr/lib:/usr/lib/${triplet}:/lib:/lib/${triplet}"
                env "CC" = "${build}/cix-stage2/tcc -B${build}/cix-stage2"
            }
            run "make" {
                "-j${jobs}"
                jobs $jobs
            }
            # Stage 2 and stage 3 are both built by compilers from this
            # source. Byte identity is the self-reproduction gate.
            run "cmp" {
                "${build}/cix-stage2/tcc"
                "${build}/tcc"
            }
        }
    }

    check {
        require directory "${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9" {
            exists
        }
        write "${build}/cix_tcc_has_include.c" """
            #if __has_include(<stdio.h>)
            int present = 1;
            #else
            #error existing header was reported absent
            #endif
            #if __has_include(<cix_missing_header.h>)
            #error missing header was reported present
            #endif
            int main(void) { return present == 1 ? 0 : 1; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_has_include.c"
            "-o"
            "${build}/cix_tcc_has_include"
        }
        run "${build}/cix_tcc_has_include" {
            expect exit 0
        }

        write "${build}/cix_tcc_dso.c" """
            extern void *__dso_handle;
            int main(void) { return &__dso_handle == (void *)0; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_dso.c"
            "-o"
            "${build}/cix_tcc_dso"
        }
        run "${build}/cix_tcc_dso" {
            expect exit 0
        }

        write "${build}/cix_tcc_bswap_so.c" """
            unsigned int swap(unsigned int value) { return __builtin_bswap32(value); }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-shared"
            "${build}/cix_tcc_bswap_so.c"
            "-o"
            "${build}/cix_tcc_bswap.so"
        }
        write "${build}/cix_tcc_dlopen.c" """
            #include <dlfcn.h>
            int main(int argc, char **argv)
            {
                void *handle;
                unsigned int (*swap)(unsigned int);
                if (argc != 2) return 10;
                handle = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
                if (!handle) return 1;
                swap = (unsigned int (*)(unsigned int))dlsym(handle, "swap");
                if (!swap || swap(0x12345678u) != 0x78563412u) return 2;
                dlclose(handle);
                return 0;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-I${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
            "${build}/cix_tcc_dlopen.c"
            "-ldl"
            "-o"
            "${build}/cix_tcc_dlopen"
        }
        run "${build}/cix_tcc_dlopen" {
            "${build}/cix_tcc_bswap.so"
            expect exit 0
        }

        write "${build}/cix_tcc_stack.c" """
            int cix_stack_value(void) { return 7; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-shared"
            "${build}/cix_tcc_stack.c"
            "-o"
            "${build}/cix_tcc_stack.so"
        }
        write "${build}/cix_tcc_stack_check.c" """
            #define _GNU_SOURCE
            #include <link.h>
            #include <string.h>
            static int found;
            static int callback(struct dl_phdr_info *info, size_t size)
            {
                int i;
                (void)size;
                if (!info->dlpi_name || !strstr(info->dlpi_name, "cix_tcc_stack.so")) return 0;
                for (i = 0; i < (int)info->dlpi_phnum; ++i)
                    if (info->dlpi_phdr[i].p_type == PT_GNU_STACK) {
                        found = (info->dlpi_phdr[i].p_flags & PF_X) == 0;
                        return 1;
                    }
                return 1;
            }
            int main(int argc, char **argv)
            {
                void *handle;
                if (argc != 2) return 10;
                handle = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
                if (!handle) return 1;
                dl_iterate_phdr(callback, 0);
                dlclose(handle);
                return found ? 0 : 2;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-I${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
            "${build}/cix_tcc_stack_check.c"
            "-ldl"
            "-o"
            "${build}/cix_tcc_stack_check"
        }
        run "${build}/cix_tcc_stack_check" {
            "${build}/cix_tcc_stack.so"
            expect exit 0
        }

        write "${build}/cix_tcc_fde.c" """
            int fde_a(int value) { return value + 1; }
            int fde_b(int value) { return value * 2 + 3; }
            int fde_c(int value) { int i, sum = 0; for (i = 0; i < value; ++i) sum += i; return sum; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-g"
            "-c"
            "${build}/cix_tcc_fde.c"
            "-o"
            "${build}/cix_tcc_fde.o"
        }
        write "${build}/cix_tcc_fde_check.c" """
            #include <elf.h>
            #include <stdio.h>
            #include <string.h>
            static int has_name(const char *table, size_t size, Elf64_Word offset, const char *name)
            {
                return offset < size && strcmp(table + offset, name) == 0;
            }
            int main(int argc, char **argv)
            {
                FILE *file;
                Elf64_Ehdr header;
                Elf64_Shdr *sections;
                char *names;
                int i, j, count = 0;
                Elf64_Addr seen[16];
                if (argc != 2) return 10;
                file = fopen(argv[1], "rb");
                if (!file || fread(&header, sizeof header, 1, file) != 1) return 1;
                if (header.e_ident[EI_CLASS] != ELFCLASS64 || header.e_shentsize != sizeof(Elf64_Shdr)) return 2;
                sections = (Elf64_Shdr *)malloc(header.e_shnum * sizeof(*sections));
                if (!sections || fseek(file, (long)header.e_shoff, SEEK_SET) || fread(sections, sizeof(*sections), header.e_shnum, file) != header.e_shnum) return 3;
                names = (char *)malloc(sections[header.e_shstrndx].sh_size);
                if (!names || fseek(file, (long)sections[header.e_shstrndx].sh_offset, SEEK_SET) || fread(names, 1, sections[header.e_shstrndx].sh_size, file) != sections[header.e_shstrndx].sh_size) return 4;
                for (i = 0; i < header.e_shnum; ++i) if (has_name(names, sections[header.e_shstrndx].sh_size, sections[i].sh_name, ".rela.eh_frame")) {
                    Elf64_Rela *relocs = (Elf64_Rela *)malloc(sections[i].sh_size);
                    size_t total = sections[i].sh_size / sizeof(*relocs);
                    if (!relocs || fseek(file, (long)sections[i].sh_offset, SEEK_SET) || fread(relocs, sizeof(*relocs), total, file) != total) return 5;
                    for (j = 0; j < (int)total && count < 16; ++j) {
                        int duplicate = 0, k;
                        for (k = 0; k < count; ++k) if (seen[k] == (Elf64_Addr)relocs[j].r_addend) duplicate = 1;
                        if (!duplicate) seen[count++] = (Elf64_Addr)relocs[j].r_addend;
                    }
                    free(relocs);
                }
                free(names); free(sections); fclose(file);
                return count >= 3 ? 0 : 6;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-I${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
            "${build}/cix_tcc_fde_check.c"
            "-o"
            "${build}/cix_tcc_fde_check"
        }
        run "${build}/cix_tcc_fde_check" {
            "${build}/cix_tcc_fde.o"
            expect exit 0
        }

        write "${build}/cix_tcc_libpath.c" """
            #include <stdio.h>
            int main(void) { return puts("cix-libpath") < 0 ? 1 : 0; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-I${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
            "${build}/cix_tcc_libpath.c"
            "-lc"
            "-o"
            "${build}/cix_tcc_libpath"
        }
        run "${build}/cix_tcc_libpath" {
            expect exit 0
        }

        write "${build}/cix_tcc_atomic.c" """
            static char lock;
            int __atomic_test_and_set(volatile void *, int);
            void __atomic_clear(volatile void *, int);
            int main(void)
            {
                if (__ATOMIC_SEQ_CST != 5 || __ATOMIC_RELAXED != 0) return 10;
                if (__atomic_test_and_set(&lock, __ATOMIC_SEQ_CST)) return 1;
                if (!__atomic_test_and_set(&lock, __ATOMIC_SEQ_CST)) return 2;
                __atomic_clear(&lock, __ATOMIC_SEQ_CST);
                return __atomic_test_and_set(&lock, __ATOMIC_SEQ_CST) ? 3 : 0;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_atomic.c"
            "-o"
            "${build}/cix_tcc_atomic"
        }
        run "${build}/cix_tcc_atomic" {
            expect exit 0
        }

        write "${build}/cix_tcc_bswap.c" """
            unsigned short __builtin_bswap16(unsigned short);
            unsigned int __builtin_bswap32(unsigned int);
            unsigned long long __builtin_bswap64(unsigned long long);
            int main(void)
            {
                if (__builtin_bswap16(0x1234u) != 0x3412u) return 1;
                if (__builtin_bswap32(0x12345678u) != 0x78563412u) return 2;
                if (__builtin_bswap64(0x0123456789abcdefULL) != 0xefcdab8967452301ULL) return 3;
                return 0;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_bswap.c"
            "-o"
            "${build}/cix_tcc_bswap"
        }
        run "${build}/cix_tcc_bswap" {
            expect exit 0
        }

        write "${build}/cix_tcc_c11.c" """
            #include <stdatomic.h>
            #if __STDC_VERSION__ < 201112L
            #error not C11
            #endif
            #ifdef __STDC_NO_ATOMICS__
            #error atomics must be advertised
            #endif
            _Static_assert(4447999631970, "64-bit assertion");
            int main(void) { return 0; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "-I${src}/tcc/tinycc-2ba12e83b3599ca8f5d50c179fe5138fe956f0c9/include"
            "${build}/cix_tcc_c11.c"
            "-o"
            "${build}/cix_tcc_c11"
        }
        run "${build}/cix_tcc_c11" {
            expect exit 0
        }
        write "${build}/cix_tcc_c11_false.c" "_Static_assert(0, \"false assertion must fail\");\nint main(void) { return 0; }\n"
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_c11_false.c"
            "-o"
            "${build}/cix_tcc_c11_false"
            expect exit 1
        }

        write "${build}/cix_tcc_ctor.c" """
            static int sequence;
            static int early;
            static int late;
            void late_ctor(void) __attribute__((constructor(900)));
            void early_ctor(void) __attribute__((constructor(100)));
            void late_ctor(void) { late = ++sequence; }
            void early_ctor(void) { early = ++sequence; }
            int main(void) { return (early == 1 && late == 2) ? 0 : 1; }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_ctor.c"
            "-o"
            "${build}/cix_tcc_ctor"
        }
        run "${build}/cix_tcc_ctor" {
            expect exit 0
        }

        write "${build}/cix_tcc_regressions.c" """
            struct pair { int a; int b; };
            enum { I0, I1, I2 };
            static int calls;
            static int condition(void) { return ++calls >= 3; }
            int main(void)
            {
                struct pair a[] = { (struct pair){1, 2}, (struct pair){3, 4}, (struct pair){5, 6} };
                struct pair b[] = { [I2]=(struct pair){30,31}, [I0]=(struct pair){10,11}, [I1]=(struct pair){20,21} };
                struct pair c[] = { 1,2, 3,4, 5,6 };
                struct pair d[] = { (1),2, (3),4 };
                static int grid[][2] = { 1,2, 3,4, 5,6 };
                static char text[] = "hello";
                int iterations = 0;
                do {
                    iterations++;
                    continue;
                } while (!condition());
                if (sizeof a / sizeof a[0] != 3 || a[2].b != 6) return 1;
                if (sizeof b / sizeof b[0] != 3 || b[0].a != 10 || b[2].a != 30) return 2;
                if (sizeof c / sizeof c[0] != 3 || c[1].a != 3) return 3;
                if (sizeof d / sizeof d[0] != 2 || d[1].b != 4) return 4;
                if (sizeof grid / sizeof grid[0] != 3 || grid[2][0] != 5) return 5;
                if (sizeof text != 6 || text[4] != 'o') return 6;
                return (iterations == 3 && calls == 3) ? 0 : 7;
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_regressions.c"
            "-o"
            "${build}/cix_tcc_regressions"
        }
        run "${build}/cix_tcc_regressions" {
            expect exit 0
        }

        write "${build}/cix_tcc_slots.c" """
            void *opaque(int n) { static char buffer[8]; return buffer + (n & 1); }
            int pick(void) { return 1; }
            static int value_survives(void)
            {
                switch (1) {
                case 0: return -1;
                { void *first; void *second;
                case 1:
                    if (pick()) first = opaque(1); else first = opaque(2);
                    second = (void *)0;
                    if (first == (void *)0 || second != (void *)0) return 1;
                    return 0;
                }
                }
                return 2;
            }
            static int addresses_differ(void)
            {
                switch (1) {
                case 0: return -1;
                { void *first; void *second;
                case 1:
                    if (pick()) first = (void *)1; else first = (void *)2;
                    second = (void *)0;
                    return (&first == &second || first == (void *)0 || second != (void *)0) ? 1 : 0;
                }
                }
                return 2;
            }
            int main(void) { return value_survives() || addresses_differ();
            }
            """
        run "${build}/tcc" {
            "-B${build}"
            "${build}/cix_tcc_slots.c"
            "-o"
            "${build}/cix_tcc_slots"
        }
        run "${build}/cix_tcc_slots" {
            expect exit 0
        }
    }

    install {
        cd $build {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        remove tree "${dest}/usr/share/man"
        require file "${dest}/usr/bin/tcc" {
            exists
        }
    }
}
