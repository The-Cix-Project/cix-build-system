# TCC migration from the legacy shell recipe tcc/0.9.28rc-29.
#
# The source and package identity are carried over exactly. The legacy recipe's
# pkg_build() is intentionally not copied: its sed/cat/for/if shell logic must
# become explicit CPDL operations or a reviewed CBS capability.
#
# Migration status:
# - source identity and build dependencies: carried over;
# - configure, build, install, and documentation pruning: represented below;
# - compatibility edits, conformance gates, and three-stage bootstrap: pending;
# - this recipe is therefore a validated migration draft, not yet a release
#   replacement for the shell recipe.
#
package "tcc" {
    version "0.9.28rc"
    release 29

    sources {
        main "tcc" {
            url "https://codeload.github.com/TinyCC/tinycc/tar.gz/2ba12e83b3599ca8f5d50c179fe5138fe956f0c9"
            sha256 "4eb5f0266d4d9deabe9650abedc3f0261dc06295f89ad798bb495abf680dc074"
        }
    }

    requires {
        build {
            compiler "tcc"
            tool "make"
            tool "linux-headers"
            tool "bash"
            tool "coreutils"
            tool "sed"
            tool "grep"
            tool "gawk"
            tool "binutils"
        }
        bootstrap {
            compiler "tcc"
        }
    }

    prepare {
        require directory $src {
            exists
        }
        # The legacy recipe patches include/tccdefs.h, lib/Makefile,
        # tccelf.c, tccdbg.c, tcc.h, tccgen.c, and adds compatibility source
        # files. Those changes need exact source-match assertions before they
        # are translated into CPDL replace/insert/write operations.
    }

    configure {
        cd $src {
            run "./configure" {
                "--prefix=/usr"
                "--cc=tcc"
                env "CC" = "tcc"
            }
        }
    }

    build {
        cd $src {
            run "make" {
                "-j${jobs}"
                jobs $jobs
            }
        }
    }

    check {
        # The legacy recipe's compiler gates are not yet represented. This
        # phase remains explicit so the migration cannot silently claim that
        # the source-level conformance checks were preserved.
        require directory $src {
            exists
        }
    }

    install {
        cd $src {
            run "make" {
                "install"
                "DESTDIR=${dest}"
            }
        }
        remove tree "${dest}/usr/share/man"
        remove tree "${dest}/usr/share/doc"
        require file "${dest}/usr/bin/tcc" {
            exists
        }
    }
}
